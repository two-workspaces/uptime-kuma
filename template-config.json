{
  "services": {
    "c4a1e7f2-9b3d-4e6a-8f15-0d2c7b9e3a48": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/uptime-kuma/main/icon.svg",
      "name": "Uptime Kuma",
      "build": {
        "dockerfilePath": "Dockerfile"
      },
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/api/entry-page",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/uptime-kuma",
        "rootDirectory": null
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "7e2b5c90-3f4d-4a1e-b6c8-91d0e5a7f324": {
          "mountPath": "/app/data"
        }
      },
      "variables": {
        "KUMA_ADMIN_USERNAME": {
          "defaultValue": "admin",
          "description": "Admin username, created on first boot",
          "isOptional": false
        },
        "KUMA_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24)}}",
          "description": "Admin password, used on first boot only - change it later in Settings, Security",
          "isOptional": false
        },
        "KUMA_BASE_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Primary base URL used in notification links, set on first boot - change it later in Settings, General",
          "isOptional": false
        },
        "UPTIME_KUMA_DB_TYPE": {
          "defaultValue": "sqlite",
          "description": "Store data in SQLite on the volume (skips the database setup page)",
          "isOptional": false
        },
        "PORT": {
          "defaultValue": "3001",
          "description": "Port Railway routes to - leave as is",
          "isOptional": false
        }
      }
    }
  }
}
